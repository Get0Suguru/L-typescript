    {
      "id": "V9sBXrdrBdM5hClEl0SAx",
      "type": "text",
      "x": 2670.6593062849315,
      "y": 1153.9568586926491,
      "width": 800,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
