      "updated": 1791487715107,
      "created": 1791487542634,
      "link": null,
      "locked": false,
      "text": "2. unknown -> better alternate of any \n\n    where any to complier is -> trust me bro\n        for unknows compiler wont trust u \n            tho both any and unknown says don't know type\n\n        but for unknows its more safe as compiler\n            won't let u compile without typecheck before \n                that operation use \n                    ex -> if(var.type == string) var.length \n                        won't give error otherwise compile eror",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. unknown -> better alternate of any \n\n    where any to complier is -> trust me bro\n        for unknows compiler wont trust u \n            tho both any and unknown says don't know type \n\n        but for unknows its more safe as compiler\n            won't let u compile without typecheck before \n                that operation use \n                    ex -> if(var.type == string) var.length \n                        won't give error otherwise compile eror ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
