      "created": 1791492749030,
      "link": null,
      "locked": false,
      "text": "ii) default parameter ->\n\n            easy just use = \"value\"  after the var_name : type in constructor \n\n        ex -> fxn_name(middlename: string = \"the\" )   ",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ii) default parameter ->\n\n            easy just use = \"value\"  after the var_name : type in constructor \n\n        ex -> fxn_name(middlename: string = \"the\" )   ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
