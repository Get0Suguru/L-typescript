    {
      "id": "JifDR10P24k8I5JW0nZcU",
      "type": "text",
      "x": 3082.4078905789943,
      "y": 4569.574175528556,
      "width": 995.3437241528526,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
