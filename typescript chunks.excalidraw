      "isDeleted": false,
      "boundElements": [],
      "updated": 1791488962246,
      "created": 1791488309886,
      "link": null,
      "locked": false,
      "text": "4. optional chaining and bang \n\n        question mark operator ? \n\n            checks weather the result of operation isn't undefined\n                if it is -> it won't move the operation chain forward\n                    u can use multi  like x.pop()?.pop()?.length\n\n        bang operator ! \n            \n           same as ? operator -> but isnt check -> it assumes  \n                the operation to be not undefined \n                   means we exicutes forward even it was undefined\n                        idk why we use it -> coz it leads to runtime e",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. optional chaining and bang \n\n        question mark operator ? \n\n            checks weather the result of operation isn't undefined\n                if it is -> it won't move the operation chain forward\n                    u can use multi  like x.pop()?.pop()?.length\n\n        bang operator ! \n            \n           same as ? operator -> but isnt check -> it assumes  \n                the operation to be not undefined \n                   means we exicutes forward even it was undefined\n                        idk why we use it -> coz it leads to runtime e",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
