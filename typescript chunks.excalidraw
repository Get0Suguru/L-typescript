      "text": "4. shadowing -> \n\n        simply ur dog having own property which is also in\n            animal -> same name -> ex  name is a prop\n",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. shadowing -> \n\n        simply ur dog having own property which is also in\n            animal -> same name -> ex  name is a prop\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "peMn2WqZqTA_CuppGZGuJ",
      "type": "text",
