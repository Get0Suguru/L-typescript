      "boundElements": null,
      "updated": 1791995357419,
      "created": 1791995255970,
      "link": null,
      "locked": false,
      "text": "3. .__proto__ rep the prototype \n\n    ex -> dog = Object.create(animal);\n\n        now -> dog.__proto__ === animal  = true",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. .__proto__ rep the prototype \n\n    ex -> dog = Object.create(animal);\n\n        now -> dog.__proto__ === animal  = true",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
