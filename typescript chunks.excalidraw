      "type": "text",
      "x": 332.7732019024781,
      "y": -5125.157967575862,
      "width": 745.2198486328125,
      "height": 840,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
