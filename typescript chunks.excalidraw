      "link": null,
      "locked": false,
      "text": "1) every object has its upper prototype as \n                        \n                    Object.prototype",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
