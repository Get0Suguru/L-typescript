    },
    {
      "id": "Mrl2oulcBWS7WwBNz6DWG",
      "type": "text",
      "x": 3101.6641307280847,
      "y": 3747.156755132008,
      "width": 942.7366485535256,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1H",
      "roundness": null,
      "seed": 986094783,
      "version": 210,
      "versionNonce": 762331473,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792017987826,
      "created": 1792017222779,
      "link": null,
      "locked": false,
      "text": "// ─── STANDARD FUNCTION SYNTAX ───\nfunction identity<T>(value: T): T_or_urchoice {\n  return value;\n}\n\n// ─── ARROW FUNCTION SYNTAX ───\n// Note: In JSX (.tsx) files, use <T,> or <T extends unknown> so\nthe compiler doesn't confuse it for an HTML tag.\nconst identityArrow = <T>(value: T): T => value; \n\n// ─── MULTIPLE TYPE PARAMETERS ───\nfunction merge<T, U>(obj1: T, obj2: U): T & U {\n  return { ...obj1, ...obj2 };\n}\n\n// ─── CALLING A GENERIC FUNCTION ───\nlet output1 = identity<string>(\"myString\"); // Explicit type argument\nlet output2 = identity(100);                // Type inference (TS\nfigures out T is number)\n",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// ─── STANDARD FUNCTION SYNTAX ───\nfunction identity<T>(value: T): T_or_urchoice {\n  return value;\n}\n\n// ─── ARROW FUNCTION SYNTAX ───\n// Note: In JSX (.tsx) files, use <T,> or <T extends unknown> so the compiler doesn't confuse it for an HTML tag.\nconst identityArrow = <T>(value: T): T => value; \n\n// ─── MULTIPLE TYPE PARAMETERS ───\nfunction merge<T, U>(obj1: T, obj2: U): T & U {\n  return { ...obj1, ...obj2 };\n}\n\n// ─── CALLING A GENERIC FUNCTION ───\nlet output1 = identity<string>(\"myString\"); // Explicit type argument\nlet output2 = identity(100);                // Type inference (TS figures out T is number)\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
