      "link": null,
      "locked": false,
      "text": "  i) tuple -> is a fixed length array \n              with \"explicitly\" type defined for each position",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  i) tuple -> is a fixed length array \n              with \"explicitly\" type defined for each position",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vIFfsY9sNUVdm1aSnnjbj",
      "type": "text",
      "x": 1527.8871994788997,
      "y": 957.3102988321639,
      "width": 627.395751953125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
