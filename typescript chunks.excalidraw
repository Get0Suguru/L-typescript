      "version": 167,
      "versionNonce": 1344182001,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792017987826,
      "created": 1792017527748,
      "link": null,
      "locked": false,
      "text": "// ─── DECLARING A GENERIC CLASS ───\nclass Box<T> {\n  contents: T;                     // Property using the generic type\n\n  constructor(value: T) {          // Constructor using the generic type\n    this.contents = value;\n  }\n\n  getContents(): T {               // Method using the generic type\n    return this.contents;\n  }\n}\n\n// ─── INSTANTIATING A GENERIC CLASS ───\nconst stringBox = new Box<string>(\"Hello\");\nconst numberBox = new Box(42);     // Type inference determines\nBox<number>\n",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// ─── DECLARING A GENERIC CLASS ───\nclass Box<T> {\n  contents: T;                     // Property using the generic type\n\n  constructor(value: T) {          // Constructor using the generic type\n    this.contents = value;\n  }\n\n  getContents(): T {               // Method using the generic type\n    return this.contents;\n  }\n}\n\n// ─── INSTANTIATING A GENERIC CLASS ───\nconst stringBox = new Box<string>(\"Hello\");\nconst numberBox = new Box(42);     // Type inference determines Box<number>\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
