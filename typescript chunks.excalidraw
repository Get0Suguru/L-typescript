      "type": "text",
      "x": 400.11736130125973,
      "y": 793.5323324839794,
      "width": 800,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
