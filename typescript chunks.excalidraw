    {
      "id": "uln-KeTHIq985tuDCcmb3",
      "type": "text",
      "x": 2672.6501642650865,
      "y": 1837.219317481889,
      "width": 893.9685209657875,
      "height": 490,
      "angle": 0,
      "strokeColor": "#1e1e1e",
