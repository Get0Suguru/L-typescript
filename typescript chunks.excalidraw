      "text": "3. explicit type casting \n\n        var_name as type (primitive/other)  -> x as number/string \n            \n            Note -> unsafe might crash in runtime \n                        if the explicit conversation isn't possible ",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. explicit type casting \n\n        var_name as type (primitive/other)  -> x as number/string \n            \n            Note -> unsafe might crash in runtime \n                        if the explicit conversation isn't possible ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
