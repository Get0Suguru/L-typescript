      "link": null,
      "locked": false,
      "text": "now when u call .name on dog -> it will travel the \n    prototype chain and bring the first one \n                 means dog's own name rather animal's",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "now when u call .name on dog -> it will travel the \n    prototype chain and bring the first one \n                 means dog's own name rather animal's",
